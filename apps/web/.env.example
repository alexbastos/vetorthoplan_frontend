# Origem HTTPS canônica da Authentication API: sem caminho, query, fragmento ou credenciais.
# Exclusiva do servidor. Nunca use o prefixo NEXT_PUBLIC_ para esta variável.
AUTHENTICATION_API_BASE_URL=https://bwtp7pm5pc.execute-api.us-east-1.amazonaws.com

# Origem da API clínica alcançável pelo processo do BFF, sem /docs nem /api/v1.
# Somente servidor. HTTP é aceito apenas em loopback durante development/test.
CLINICAL_API_BASE_URL=https://bwtp7pm5pc.execute-api.us-east-1.amazonaws.com
# JWT: BFF troca o token geral por um token vetorthoplan-api da organização escolhida.
# A seleção é automática somente com uma organização ativa; com várias, a tela pede escolha.
# Não colocar /authentication_api/api/v1/auth na variável de autenticação: o cliente já inclui esse prefixo.
# Não configurar tokens estáticos ou tenant/ator do usuário no .env do frontend.
CLINICAL_API_IDENTITY_MODE=jwt
# Alternativa local: CLINICAL_API_BASE_URL=http://127.0.0.1:8000 e CLINICAL_API_IDENTITY_MODE=local.
# O backend local/test configura seus próprios IDENTITY_MODE=local, LOCAL_TENANT_ID e LOCAL_ACTOR_ID.

# Origem pública canônica do BFF. HTTPS é obrigatório fora do loopback local.
# Usada para validar Origin em mutações de sessão e consentimento.
APP_ORIGIN=http://localhost:3000

# Observação avançada da CSP. Permanece desativada no MVP; habilite somente em
# um ambiente de validação para voltar a emitir nonces e o header Report-Only.
CSP_REPORT_ONLY_ENABLED=false
# Origens exatas dos storages que receberão o POST direto do navegador.
# Necessário quando a CSP Report-Only estiver habilitada. Separe múltiplas origens por vírgula.
# Exemplo local: UPLOAD_STORAGE_ORIGINS=http://127.0.0.1:9000
UPLOAD_STORAGE_ORIGINS=
# Origens exatas que servem prévias temporárias. Necessário para CSP Report-Only.
PREVIEW_STORAGE_ORIGINS=

# Chave runtime-only usada para cifrar e autenticar os cookies de sessão.
# Deve conter exatamente 32 bytes aleatórios em base64url (43 caracteres).
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_COOKIE_SECRET=

# Opcional durante rotação: mantenha aqui a chave anterior por no máximo 7 dias,
# enquanto SESSION_COOKIE_SECRET recebe uma chave nova. Depois remova-a.
# SESSION_COOKIE_PREVIOUS_SECRET=

# Segredo runtime-only, exclusivo deste ambiente, para transações OAuth temporárias.
# Deve conter exatamente 32 bytes aleatórios em base64url (43 caracteres, sem padding).
# Não exponha, não reutilize entre ambientes e não envie como build argument.
# A rotação invalida as transações OAuth em andamento (duração máxima: 10 minutos).
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
OAUTH_TRANSACTION_SECRET=

# Identificador público OAuth 2.0 Web do Google. Não é um segredo e será
# incorporado ao bundle do navegador durante o build.
# Este BFF não utiliza GOOGLE_CLIENT_SECRET; não forneça essa credencial aqui.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
